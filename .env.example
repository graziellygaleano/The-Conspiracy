# ============================================
# Configuração - The Conspiracy (BD 2)
# Copie este arquivo para .env e ajuste conforme precisar
# ============================================

# --- Planilhas de entrada ---
# Para testar rápido, use dados/exemplo/...
# Quando baixar as bases reais, troque para dados/reais/...
ARQUIVO_POSTS=dados/exemplo/posts_exemplo.csv
ARQUIVO_ARTIGOS=dados/exemplo/artigos_exemplo.csv

# --- MySQL (Artigos Científicos) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=sua_senha_aqui
MYSQL_DATABASE=conspiracy_db

# --- MongoDB (Posts / Tweets) ---
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DATABASE=conspiracy_db
MONGO_COLLECTION=posts
