# ============================================
# Configuração de Conexão - The Conspiracy ETL
# Copie este arquivo para .env e ajuste suas credenciais
# ============================================

# --- MySQL (Metadados dos Artigos Científicos) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=sua_senha_aqui
MYSQL_DATABASE=conspiracy_db

# --- MongoDB (Postagens / Tweets Filtrados) ---
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DATABASE=conspiracy_db
MONGO_COLLECTION=conspiracy_tweets
